# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Railway / Supabase / local Docker all work)
DATABASE_URL="postgresql://user:password@localhost:5432/cpage?schema=public"

# ── Auth.js / NextAuth ──────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-32-byte-base64-secret"
AUTH_TRUST_HOST="true"

# GitHub OAuth (https://github.com/settings/developers)
# Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ── Judge0 CE code execution ────────────────────────────────────────────────
# Public CE instance works with no key for light use.
# Self-host with Docker for production: https://github.com/judge0/judge0
JUDGE0_API_URL="https://ce.judge0.com"
# RapidAPI mode (optional). Set both, and JUDGE0_API_URL to the RapidAPI URL.
JUDGE0_API_KEY=""
JUDGE0_API_HOST=""

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"